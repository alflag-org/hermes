{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alflag.org/hermes/schemas/dns-zone-plan.v1.schema.json",
  "type": "object",
  "required": ["kind", "version", "domain", "actions"],
  "properties": {
    "kind": { "const": "sync-plan" },
    "version": { "const": "v1" },
    "site": { "type": ["string", "null"] },
    "domain": { "const": "dns" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "zone", "name", "type", "value"],
        "properties": {
          "action": { "enum": ["upsert-record", "delete-record"] },
          "zone": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  }
}
